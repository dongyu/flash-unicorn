APP_ENV=development
SERVER_MODE=all
HTTP_ADDR=:3331
SHUTDOWN_TIMEOUT=15s

DATABASE_URL=sqlite://./tmp/dev.db

LOG_LEVEL=debug
LOG_FORMAT=console

RIVER_MAX_WORKERS=10

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLE_TRACING=false
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_FLUSH_TIMEOUT=2s

AUTH_ISSUER=unicorn
AUTH_SECRET=unicorn-development-signing-key-0001
AUTH_ACCESS_TTL=15m
AUTH_LEEWAY=30s
AUTH_BCRYPT_COST=4
