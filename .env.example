# Application runtime mode: all | api | worker
APP_ENV=development
SERVER_MODE=all
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=15s

# Unified database connection URL (shared by server, migrate CLI, river, and sqlc)
# SQLite (default for zero-dependency local dev):
DATABASE_URL=sqlite://./tmp/dev.db
# PostgreSQL example:
# DATABASE_URL=postgres://unicorn:unicorn@localhost:5432/unicorn?sslmode=disable

# Logging (zerolog): debug | info | warn | error
LOG_LEVEL=debug
LOG_FORMAT=console

# River queue worker concurrency
RIVER_MAX_WORKERS=10

# Sentry (leave SENTRY_DSN empty in local dev to disable reporting)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLE_TRACING=false
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_FLUSH_TIMEOUT=2s
